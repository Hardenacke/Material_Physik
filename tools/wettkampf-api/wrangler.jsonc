{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "physik-wettkampf-api",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-27",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../../klasse-8/01-optische-instrumente/lernpfade/wettkaempfe",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "GROUP_ACCESS", "class_name": "GroupAccess" },
      { "name": "ROOM_STATE", "class_name": "RoomState" },
      { "name": "ARCHIVE_WRITER", "class_name": "ArchiveWriter" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GroupAccess", "RoomState", "ArchiveWriter"] }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://hardenacke.github.io,http://127.0.0.1:8787,http://localhost:8787",
    "ARCHIVE_MODE": "github",
    "ARCHIVE_REPOSITORY": "Hardenacke/Material_Physik",
    "ARCHIVE_ALLOW_PUBLIC": "true",
    "ARCHIVE_BRANCH": "main",
    "ARCHIVE_PREFIX": "ergebnisse"
  },
  "observability": { "enabled": false }
}
