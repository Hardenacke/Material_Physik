{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Privater Fragenpool physik",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "subject",
    "title",
    "grade",
    "demo",
    "questions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "subject": {
      "const": "physik"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "grade": {
      "type": "string",
      "minLength": 1
    },
    "demo": {
      "type": "boolean"
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "difficulty",
          "family",
          "prompt",
          "choices",
          "correct",
          "explanation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "kind": {
            "enum": [
              "single-choice",
              "number",
              "ray"
            ]
          },
          "difficulty": {
            "enum": [
              "basis",
              "aufbau",
              "knifflig"
            ]
          },
          "family": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "prompt": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "value"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "text",
                    "math"
                  ]
                },
                "value": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "choices": {
            "type": "array",
            "minItems": 0,
            "maxItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "content"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "content": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "type",
                      "value"
                    ],
                    "properties": {
                      "type": {
                        "enum": [
                          "text",
                          "math"
                        ]
                      },
                      "value": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              }
            }
          },
          "correct": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              {
                "type": "number",
                "minimum": 0,
                "maximum": 90
              }
            ]
          },
          "explanation": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "value"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "text",
                    "math"
                  ]
                },
                "value": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "figure": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "src",
              "alt"
            ],
            "properties": {
              "src": {
                "type": "string",
                "pattern": "^assets/[a-zA-Z0-9/_-]+\\.svg$"
              },
              "alt": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "tolerance": {
            "type": "number",
            "minimum": 0,
            "maximum": 5
          },
          "interaction": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "category"
            ],
            "properties": {
              "category": {
                "enum": [
                  "Grundbegriffe",
                  "Reflexion",
                  "Brechung"
                ]
              },
              "fieldLabel": {
                "type": "string",
                "minLength": 1
              },
              "diagram": {
                "enum": [
                  "reflection",
                  "refractionReading",
                  "refractionDraw"
                ]
              },
              "incidence": {
                "type": "number",
                "exclusiveMinimum": 0,
                "exclusiveMaximum": 90
              },
              "refractedAngle": {
                "type": "number",
                "exclusiveMinimum": 0,
                "exclusiveMaximum": 90
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "single-choice"
                }
              }
            },
            "then": {
              "properties": {
                "choices": {
                  "minItems": 2
                },
                "correct": {
                  "type": "string"
                }
              },
              "not": {
                "required": [
                  "tolerance"
                ]
              }
            },
            "else": {
              "required": [
                "tolerance",
                "interaction"
              ],
              "properties": {
                "choices": {
                  "maxItems": 0
                },
                "correct": {
                  "type": "number"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "number"
                }
              }
            },
            "then": {
              "properties": {
                "interaction": {
                  "required": [
                    "fieldLabel"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "ray"
                }
              }
            },
            "then": {
              "properties": {
                "interaction": {
                  "required": [
                    "incidence",
                    "diagram"
                  ],
                  "properties": {
                    "diagram": {
                      "enum": [
                        "reflection",
                        "refractionDraw"
                      ]
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}
